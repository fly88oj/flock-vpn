# syntax=docker/dockerfile:1
# echo —— the echo endpoint of the A1 byte-passthrough harness (docs/design.md
# §6.3 A1: 1MiB random + the full 256-byte value echoed back over the relay,
# sha256 identical —— the e2e replica of frp-compat T1/T2).
# socat TCP-LISTEN fork + EXEC:cat = full-duplex byte echo (no framing, no
# rewriting).

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends socat \
 && rm -rf /var/lib/apt/lists/*
EXPOSE 9001
ENTRYPOINT ["socat", "TCP-LISTEN:9001,reuseaddr,fork", "EXEC:cat"]
