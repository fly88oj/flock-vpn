# syntax=docker/dockerfile:1
# frpc (stock v0.71.1 pinned) —— the e2e sidecar container (docs/design.md §6.2
# M5: frpc-a/frpc-b).
#
# In the production form frpc is an in-process child of the server (§3.9
# Supervisor); the e2e topology uses a dedicated sidecar container to carry the
# registration (§6.2 "the same Supervisor code, two deployments"). The config
# file is volume-mounted by compose (frpc-a.toml / frpc-b.toml, differing only
# in serverAddr/remotePort).
# The binary is taken directly from .tmp/frp_0.71.1_linux_amd64/ via the named
# build context `bins` (same as Dockerfile.frps).

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends procps \
 && rm -rf /var/lib/apt/lists/*
COPY --from=bins frpc /usr/local/bin/frpc
RUN chmod +x /usr/local/bin/frpc
ENTRYPOINT ["/usr/local/bin/frpc"]
