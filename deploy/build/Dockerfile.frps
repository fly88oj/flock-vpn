# syntax=docker/dockerfile:1
# frps (stock v0.71.1 pinned, docs/design.md §5/§7-M2: the relay node of m2.yml).
#
# Main context = deploy/build/ (only this Dockerfile + frps.toml, kept small);
# the binary is taken directly from .tmp/frp_0.71.1_linux_amd64/ via the
# **named build context** `bins` (compose's build.additional_contexts ——
# `up -d --build` needs no copy pre-step; the main context's root
# .dockerignore does not apply to named contexts).
# frps is a static Go binary ⇒ a scratch base suffices.

FROM scratch
COPY --from=bins frps /usr/local/bin/frps
COPY frps.toml /etc/frps.toml
ENTRYPOINT ["/usr/local/bin/frps", "-c", "/etc/frps.toml"]
