# syntax=docker/dockerfile:1
# frps（原版 v0.71.1 定版，docs/design.md §5/§7-M2：m2.yml 的中转节点）。
#
# 主 context = deploy/build/（仅本 Dockerfile + frps.toml，保持小）；
# 二进制经**命名构建上下文** `bins` 直取 .tmp/frp_0.71.1_linux_amd64/
# （compose 的 build.additional_contexts——`up -d --build` 免任何拷贝前置步骤；
# 主 context 的根 .dockerignore 不作用于命名 context）。
# frps 为静态 Go 二进制 ⇒ scratch 基底即可。

FROM scratch
COPY --from=bins frps /usr/local/bin/frps
COPY frps.toml /etc/frps.toml
ENTRYPOINT ["/usr/local/bin/frps", "-c", "/etc/frps.toml"]
