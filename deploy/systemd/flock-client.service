# flock-client systemd unit sample (docs/design.md §7-M6.3)
# The real install is generated by `flock-client install`
# (/etc/systemd/system/flock-client.service, with the install-time --config
# absolute path written into ExecStart); this sample is for deployment review
# and manual deployment reference.
# Note: systemd only loads units under /etc/systemd/system (and
# /usr/lib/systemd/system etc.) —— the /etc/systemd root is not a unit search
# path; the earlier wording (/etc/systemd/...) was a typo.
# Exit semantics (§7-M6.1): Restart=on-failure —— a graceful stop via IPC
# Shutdown/SIGTERM ends with exit code 0 and systemd does not revive it; only
# failed exits (panic/crash) restart after 5s.
[Unit]
Description=Flock VPN Client (Flock VPN daemon)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/flock-client service --config /etc/flock/client.toml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
