# syntax=docker/dockerfile:1
# Dockerfile.buildbin —— 真·多机组网实测的发布二进制构建（真机清单 docs/manual/multinode-test.md）。
#
#   docker buildx build -f deploy/multinode/Dockerfile.buildbin \
#     --output type=local,dest=deploy/multinode/out .
#
# 产物（out/）：flock-server-direct（单服 Direct 构建档，无 multi-primary——
# 与 Dockerfile.server-direct 同档）、flock-server-mp（multi-primary 档——跨机 Raft
# 用，与 e2e.yml 的 server_features 同档）、flock-client（strip 过）。全部 Linux amd64
# release，glibc bookworm（与既有 deploy 镜像运行段一致）。
#
# 构建段/运行环境同一 Debian suite 钉 bookworm（glibc 符号版本，见 Dockerfile.server
# 头注）；依赖层缓存手法与 Dockerfile.server 相同（manifest+stub 先行）。

FROM rust:1.98-slim-bookworm AS builder
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates/flock-protocol/Cargo.toml crates/flock-protocol/
COPY crates/flock-frpc/Cargo.toml crates/flock-frpc/
COPY crates/flock-sync/Cargo.toml crates/flock-sync/
COPY app/flock-server/Cargo.toml app/flock-server/
COPY app/flock-client/Cargo.toml app/flock-client/
# —— 依赖层（stub 源）——
RUN mkdir -p crates/flock-protocol/src crates/flock-protocol/benches \
             crates/flock-frpc/src crates/flock-sync/src \
             app/flock-server/src app/flock-client/src \
 && echo 'pub fn _stub() {}' > crates/flock-protocol/src/lib.rs \
 && echo 'fn main() {}' > crates/flock-protocol/benches/aead.rs \
 && echo 'pub fn _stub() {}' > crates/flock-frpc/src/lib.rs \
 && echo 'pub fn _stub() {}' > crates/flock-sync/src/lib.rs \
 && echo 'pub fn _stub() {}' > app/flock-server/src/lib.rs \
 && echo 'fn main() {}' > app/flock-server/src/main.rs \
 && echo 'pub fn _stub() {}' > app/flock-client/src/lib.rs \
 && echo 'fn main() {}' > app/flock-client/src/main.rs \
 && cargo build --release --locked -p flock-server -p flock-client \
 && rm -rf target/release/deps/flock_server* target/release/deps/flock_client* \
          target/release/deps/flock_protocol* target/release/deps/flock_frpc* \
          target/release/deps/flock_sync* \
 && rm -f target/release/flock-server target/release/flock-client

# —— 源码层：两个构建档 + 客户端 ——
COPY crates/flock-protocol/src crates/flock-protocol/src
COPY crates/flock-frpc/src crates/flock-frpc/src
COPY crates/flock-sync/src crates/flock-sync/src
COPY app/flock-client/src app/flock-client/src
COPY app/flock-server/src app/flock-server/src
RUN touch crates/flock-protocol/src/lib.rs crates/flock-frpc/src/lib.rs \
      crates/flock-sync/src/lib.rs \
      app/flock-client/src/lib.rs app/flock-client/src/main.rs \
      app/flock-server/src/lib.rs app/flock-server/src/main.rs \
 # 单服 Direct 档（与 Dockerfile.server-direct 一致：无 multi-primary）
 && cargo build --release --locked -p flock-server \
 && cp target/release/flock-server /tmp/flock-server-direct \
 # multi-primary 档（跨机 Raft；与 e2e.yml server_features 一致）
 && cargo build --release --locked -p flock-server --features multi-primary \
 && cp target/release/flock-server /tmp/flock-server-mp \
 && cargo build --release --locked -p flock-client \
 && strip /tmp/flock-server-direct /tmp/flock-server-mp target/release/flock-client

FROM scratch
COPY --from=builder /tmp/flock-server-direct /out/flock-server-direct
COPY --from=builder /tmp/flock-server-mp /out/flock-server-mp
COPY --from=builder /src/target/release/flock-client /out/flock-client
