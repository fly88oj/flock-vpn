# client.toml.example —— the client config template for the multi-machine test
# (same shape for LXD/Windows Docker).
#
# The orchestration (multinode_assert.sh / manual) renders per node:
#   state_dir: LXD=/var/lib/flock; Docker=same path inside the volume
#   endpoints: the pinned access endpoint (scenario 1 = jowency:9443; scenario 2
#     split by side —— the Windows side points at the server-1 direct port, the
#     LXD side at the frps user port 24000)
#   [auth] username: the device-add account name (login registers the hostname/
#     account columns)

state_dir = "/var/lib/flock"

tun_name = "tun0"
mtu = 1280

# Endpoint override (pinned access endpoint; rotating over all root-signed
# directory endpoints is the default behavior, see §2.3)
endpoints = ["@ENDPOINT@"]

[auth]
username = "@USER@"
