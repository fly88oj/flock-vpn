# client.toml.example —— 多机实测客户端配置模板（LXD/Windows Docker 同形）。
#
# 编排（multinode_assert.sh / 手工）按节点渲染：
#   state_dir：LXD=/var/lib/flock；Docker=卷内同路径
#   endpoints：钉死接入端点（场景一 = jowency:9443；场景二按侧分布——
#     Windows 侧指向 server-1 直连口，LXD 侧指向 frps 用户口 24000）
#   [auth] username：device-add 开户名（login 入册 hostname/账户列）

state_dir = "/var/lib/flock"

tun_name = "tun0"
mtu = 1280

# 端点覆盖（钉死接入端点；根签目录全端点轮询为缺省行为，见 §2.3）
endpoints = ["@ENDPOINT@"]

[auth]
username = "@USER@"
