# flock-client —— M6 systemd real-machine-semantics test container (the client
# service of deploy/systemd-test.yml).
#
# The differences from Dockerfile.client materialize the "Linux service form":
#   - the runtime stage installs systemd (PID 1 runs /sbin/init; --privileged +
#     STOPSIGNAL SIGRTMIN+3 come from systemd-test.yml —— docker stop/restart is
#     then a systemd-semantics "shutdown/boot");
#   - the physical-machine single-box surface is stripped (getty/udev/networkd/
#     networkd-wait-online etc. —— the classic systemd-in-docker recipe;
#     network-online.target.wants stripped too, to prevent wait-online hanging);
#   - tool face: iproute2/iputils-ping/procps (assertions and diagnostics) +
#     socat (S6: hand-submitting the IPC Shutdown frame —— the postcard
#     CtrlReq::Shutdown is isomorphic to the tray's stop, see systemd_assert.sh).
#     No dbus/display stack installed (S5 headless semantics: systemctl goes
#     through the /run/systemd/private private socket).
#
# The build stage is line-by-line isomorphic to Dockerfile.client (BuildKit
# instruction-level layer-cache sharing, no duplicated compile cost).

FROM rust:1.98-slim-bookworm AS builder
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates/flock-frpc/Cargo.toml crates/flock-frpc/
COPY crates/flock-sync/Cargo.toml crates/flock-sync/
COPY app/flock-server/Cargo.toml app/flock-server/
COPY app/flock-client/Cargo.toml app/flock-client/
# flock-protocol is a git dependency (separate repo, v0.1.0): in-image builds
# fetch it from GitHub.
RUN mkdir -p crates/flock-frpc/src crates/flock-sync/src \
             app/flock-server/src app/flock-client/src \
 && echo 'pub fn _stub() {}' > crates/flock-frpc/src/lib.rs \
 && echo 'pub fn _stub() {}' > crates/flock-sync/src/lib.rs \
 && echo 'pub fn _stub() {}' > app/flock-server/src/lib.rs \
 && echo 'fn main() {}' > app/flock-server/src/main.rs \
 && echo 'pub fn _stub() {}' > app/flock-client/src/lib.rs \
 && echo 'fn main() {}' > app/flock-client/src/main.rs \
 && cargo build --release --locked -p flock-client \
 && rm -rf target/release/deps/flock_client* \
 && rm -f target/release/flock-client

COPY app/flock-client/src app/flock-client/src
RUN touch app/flock-client/src/lib.rs \
      app/flock-client/src/main.rs \
 && cargo build --release --locked -p flock-client

FROM debian:bookworm-slim
# systemd-sysv provides /sbin/init (Debian split: the systemd package proper
# only ships /lib/systemd/systemd).
RUN apt-get update \
 && apt-get install -y --no-install-recommends iproute2 iputils-ping procps socat systemd systemd-sysv \
 && rm -rf /var/lib/apt/lists/*
# systemd container minimization (strip the physical-machine face; keep the
# tmpfiles sysinit bits).
RUN for i in /lib/systemd/system/sysinit.target.wants/*; do \
        [ "$(basename "$i")" = systemd-tmpfiles-setup.service ] || rm -f "$i"; \
    done ; \
    rm -f /lib/systemd/system/multi-user.target.wants/* \
          /etc/systemd/system/*.wants/* \
          /lib/systemd/system/local-fs.target.wants/* \
          /lib/systemd/system/sockets.target.wants/*udev* \
          /lib/systemd/system/sockets.target.wants/*initctl* \
          /lib/systemd/system/basic.target.wants/* \
          /lib/systemd/system/network-online.target.wants/* \
          /lib/systemd/system/timers.target.wants/* \
    ; rm -f /etc/machine-id ; systemd-machine-id-setup || true
COPY --from=builder /src/target/release/flock-client /usr/local/bin/flock-client
RUN mkdir -p /var/lib/flock
COPY deploy/client.toml /etc/flock/client.toml
# docker stop/restart → SIGRTMIN+3 = a clean systemd shutdown (the shutdown face
# of the M6 "boot autostart" field test).
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/sbin/init"]
