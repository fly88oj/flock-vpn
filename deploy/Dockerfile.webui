# flock-webui —— M8 Web UI assertion image (docs/design.md §7-M8.9, the server
# face of deploy/webui.yml).
#
# Differences from Dockerfile.server-direct: ① the runtime stage carries
# curl/jq (W1 assertions); ② additionally builds and installs
# examples/webui_login (the HTTP-OPAQUE driver for W2/W3/W4/W6). The build
# pattern reuses manifest+stub dependency-layer caching; glibc pinned to
# bookworm on both sides.
#
# build args (M8b W6 dual tier):
#   server_features default ""       —— single-server Direct (W1–W5/W7 topology)
#   server_features "multi-primary"  —— two-voter Raft (server_conf uses
#   server-webui-{a,b}.toml; the W6 dual-VIP consistency assertion)

FROM rust:1.98-slim-bookworm AS builder
ARG server_features=""
ARG server_conf="server-webui.toml"
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates/flock-frpc/Cargo.toml crates/flock-frpc/
COPY crates/flock-sync/Cargo.toml crates/flock-sync/
COPY app/flock-server/Cargo.toml app/flock-server/
COPY app/flock-client/Cargo.toml app/flock-client/
# flock-protocol is a git dependency (separate repo, v0.1.0): in-image builds
# fetch it from GitHub.
RUN mkdir -p crates/flock-frpc/src crates/flock-sync/src \
             app/flock-server/src app/flock-server/examples app/flock-client/src \
 && echo 'pub fn _stub() {}' > crates/flock-frpc/src/lib.rs \
 && echo 'pub fn _stub() {}' > crates/flock-sync/src/lib.rs \
 && echo 'pub fn _stub() {}' > app/flock-server/src/lib.rs \
 && echo 'fn main() {}' > app/flock-server/src/main.rs \
 && echo 'fn main() {}' > app/flock-server/examples/webui_login.rs \
 && echo 'pub fn _stub() {}' > app/flock-client/src/lib.rs \
 && echo 'fn main() {}' > app/flock-client/src/main.rs \
 && cargo build --release --locked -p flock-server --example webui_login \
 && rm -rf target/release/deps/flock_server* target/release/deps/flock_server_lib* \
          target/release/deps/flock_client* \
          target/release/deps/flock_frpc* target/release/deps/flock_sync* \
          target/release/deps/webui_login* \
 && rm -f target/release/flock-server target/release/examples/webui_login
COPY crates/flock-frpc/src crates/flock-frpc/src
COPY crates/flock-sync/src crates/flock-sync/src
COPY app/flock-client/src app/flock-client/src
COPY app/flock-server/src app/flock-server/src
COPY app/flock-server/examples app/flock-server/examples
RUN if [ -n "$server_features" ]; then FEAT="--features $server_features"; else FEAT=""; fi \
 && touch crates/flock-frpc/src/lib.rs crates/flock-sync/src/lib.rs \
      app/flock-client/src/lib.rs app/flock-client/src/main.rs \
      app/flock-server/src/lib.rs app/flock-server/src/main.rs \
      app/flock-server/examples/webui_login.rs \
 && cargo build --release --locked -p flock-server --bins --example webui_login $FEAT

FROM debian:bookworm-slim
# ARGs are scoped per build stage —— the final stage must redeclare them for
# COPY expansion (otherwise the empty string ⇒ the whole directory is copied in).
ARG server_conf="server-webui.toml"
# curl/jq: the W1 not-logged-in 401 assertions and response parsing (inside this
# container at 127.0.0.1:9800).
RUN apt-get update \
 && apt-get install -y --no-install-recommends procps curl jq \
 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/target/release/flock-server /usr/local/bin/flock-server
COPY --from=builder /src/target/release/examples/webui_login /usr/local/bin/webui_login
RUN mkdir -p /var/lib/flock
COPY deploy/$server_conf /etc/flock/server.toml
ENTRYPOINT ["/usr/local/bin/flock-server"]
CMD ["--config", "/etc/flock/server.toml"]
