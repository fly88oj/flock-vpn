<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- flock-client LaunchDaemon sample (docs/design.md §7-M6.3).
     The real install is written by `flock-client install` to
     /Library/LaunchDaemons/com.flockvpn.client.plist.
     Exit semantics (§7-M6.1): no KeepAlive —— after a graceful stop via IPC
     Shutdown/SIGTERM, launchd does not revive it.
     Warning: no macOS device locally ⇒ unverified (real-machine checklist:
     docs/manual/service-install.md). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.flockvpn.client</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/flock-client</string>
        <string>service</string>
        <string>--config</string>
        <string>/etc/flock/client.toml</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- stderr persisted to disk (launchd does not inherit the session's
         stdout/stderr —— unspecified means lost). Rotation suggestion: on macOS
         use newsyslog, adding a line to /etc/newsyslog.d/flock-client.conf:
         `/var/log/flock-client.log root:wheel 640 3 1024 * J`
         (3 archives, 1024KB each, J=compress), guarding against unbounded
         growth over long runs. -->
    <key>StandardErrorPath</key>
    <string>/var/log/flock-client.log</string>
</dict>
</plist>
