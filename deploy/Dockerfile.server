# flock-server —— Frp-mode image (docs/design.md §7-M2: the server service of m2.yml).
#
# Dependency-layer caching: first copy only manifests + stub sources to build the
# dependency layer, then copy the real sources and rebuild —— source changes do
# not re-pull dependencies. The frpc binary is taken directly from
# .tmp/frp_0.71.1_linux_amd64/ via the named build context `frpbin`
# (compose build.additional_contexts —— no copy pre-step).
# For the direct variant use Dockerfile.server-direct (that image does not even
# contain the frpc binary).

# The build stage and the runtime stage must be the same Debian suite (glibc
# symbol-version compatibility): the GLIBC_2.x the binary links against depends
# on the build-stage base; rust:1.98-slim currently = trixie (glibc 2.41), while
# a bookworm (2.36) runtime stage would crash (GLIBC_2.39 not found) —— both
# sides are pinned explicitly to bookworm.
FROM rust:1.98-slim-bookworm AS builder
# zstd-sys (flock-protocol default tier) contains C sources and needs gcc
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates/flock-frpc/Cargo.toml crates/flock-frpc/
COPY crates/flock-sync/Cargo.toml crates/flock-sync/
COPY app/flock-server/Cargo.toml app/flock-server/
# flock-server depends on flock-client (M3 data plane: TunDevice/route seam
# reuse, §2.2/§3.12).
COPY app/flock-client/Cargo.toml app/flock-client/
# —— dependency layer (stub sources) ——
# flock-protocol is already a git dependency (separate repo, v0.1.0): in-image
# builds fetch it from GitHub; it no longer enters the stub layer (one build
# with the real lockfile, the cache reused across both stages).
RUN mkdir -p crates/flock-frpc/src crates/flock-sync/src \
             app/flock-server/src app/flock-client/src \
 && echo 'pub fn _stub() {}' > crates/flock-frpc/src/lib.rs \
 && echo 'pub fn _stub() {}' > crates/flock-sync/src/lib.rs \
 && echo 'pub fn _stub() {}' > app/flock-server/src/lib.rs \
 && echo 'fn main() {}' > app/flock-server/src/main.rs \
 && echo 'pub fn _stub() {}' > app/flock-client/src/lib.rs \
 && echo 'fn main() {}' > app/flock-client/src/main.rs \
 && cargo build --release --locked -p flock-server \
 && rm -rf target/release/deps/flock_server* target/release/deps/flock_server_lib* \
          target/release/deps/flock_client* \
          target/release/deps/flock_frpc* target/release/deps/flock_sync* \
 && rm -f target/release/flock-server target/release/flock-client

# —— source layer ——
# server_features: the build tier (the e2e multi-primary topology passes
# "multi-primary" —— §6.2 M5; default empty = single server).
ARG server_features=""
COPY crates/flock-frpc/src crates/flock-frpc/src
COPY crates/flock-sync/src crates/flock-sync/src
COPY app/flock-client/src app/flock-client/src
COPY app/flock-server/src app/flock-server/src
RUN touch crates/flock-frpc/src/lib.rs crates/flock-sync/src/lib.rs \
      app/flock-client/src/lib.rs app/flock-client/src/main.rs \
      app/flock-server/src/lib.rs app/flock-server/src/main.rs \
 && cargo build --release --locked -p flock-server --features "${server_features}"

FROM debian:bookworm-slim
# procps: the §7-M2 Direct-form assertion (pgrep -f frp finds no process inside
# the container) needs pgrep; iproute2/iperf3: the M3 data-plane assertions
# (A3 ip link / A4 iperf3 server); netcat-openbsd: the in-tunnel nc throughput
# comparison face for M5 A11's compression-off-by-default check.
RUN apt-get update \
 && apt-get install -y --no-install-recommends procps iproute2 iperf3 netcat-openbsd \
 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/target/release/flock-server /usr/local/bin/flock-server
# Stock frpc v0.71.1 pinned binary (named context `frpbin` ← .tmp; the main
# context need not carry it)
COPY --from=frpbin frpc /usr/local/bin/frpc
RUN chmod +x /usr/local/bin/frpc && mkdir -p /var/lib/flock
# server.toml can be swapped via a build argument (m3.yml passes server-m3.toml:
# container-network-view endpoints); default = server-frp.toml (M2 host view,
# behavior unchanged).
ARG server_conf=server-frp.toml
COPY deploy/${server_conf} /etc/flock/server.toml
ENTRYPOINT ["/usr/local/bin/flock-server"]
CMD ["--config", "/etc/flock/server.toml"]
